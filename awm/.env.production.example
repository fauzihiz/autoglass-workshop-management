# ============================================================
# Render + Supabase Production Environment Variables
# ============================================================
# Paste these into Render → Environment tab (not a real .env file).
# Generate APP_KEY with: php artisan key:generate --show
# ============================================================

APP_NAME="Workshop Management System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<generate-with-php-artisan-key-generate---show>
APP_URL=https://<your-render-url>.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---- Database (Supabase PostgreSQL) ----
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=<your-supabase-password>

# ---- Session / Cache / Queue (all use PostgreSQL) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
